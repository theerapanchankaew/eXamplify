# Copy to .env.local (local dev) or set these in your host's dashboard.
# Firebase Console → Project settings → General → Your apps → Web app config.

# ── Client (browser) ─────────────────────────────────────────────
# Inlined at BUILD time: set before `next build` / pass as Docker build args.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional: grading endpoint. Leave empty to use the built-in /api/grade-exam.
NEXT_PUBLIC_GRADE_EXAM_URL=

# Optional: local Firebase Emulator Suite
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=localhost

# ── Server (secret — never prefix with NEXT_PUBLIC_) ─────────────
# Needed on Vercel / Netlify / self-hosted Docker.
# NOT needed on Cloud Run or Firebase App Hosting (built-in credentials).
# Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep the quotes; "\n" line breaks are converted automatically.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
