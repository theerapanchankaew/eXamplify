# eXamplify configuration — copy to .env and edit. Never commit .env.
# All values are read at runtime; no rebuild is needed after changes
# (restart with: docker compose up -d).

# ── Site ─────────────────────────────────────────────────────────
# Public URL users open in the browser.
APP_URL=https://examplify.example.org
# Host name Caddy serves (usually the host part of APP_URL).
SITE_ADDRESS=examplify.example.org
# auto = Let's Encrypt (public DNS + ports 80/443 open to the internet)
# files = own certificate in deploy/certs/fullchain.pem + privkey.pem
# internal = Caddy's internal CA (intranet / testing)
TLS_MODE=auto
# HTTP_PORT=80
# HTTPS_PORT=443

# ── Database ─────────────────────────────────────────────────────
# Letters and digits only (it is embedded in a connection URL).
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-to-a-long-random-value
# DATABASE_URL is set by docker-compose.yml. Set it yourself only when
# running outside Docker, e.g. postgres://examplify:PASSWORD@localhost:5432/examplify
# DATABASE_URL=
# DATABASE_POOL_MAX=10

# ── Accounts ─────────────────────────────────────────────────────
# Comma-separated e-mails that become Admin when they sign up.
BOOTSTRAP_ADMIN_EMAILS=
# false = only administrators can create accounts (Users page).
ALLOW_SIGNUP=true
SESSION_TTL_DAYS=7
# Cookie "Secure" flag; defaults to true when APP_URL starts with https://
# COOKIE_SECURE=true

# ── Backups ──────────────────────────────────────────────────────
BACKUP_KEEP_DAYS=14
# BACKUP_DIR=./backups
TZ=Asia/Bangkok

# ── Migration from Firebase (only when importing old users) ──────
# Firebase Console → Authentication → Users → ⋮ → Password hash parameters.
# Needed so users imported from Firebase can sign in with their old password.
FIREBASE_HASH_SIGNER_KEY=
FIREBASE_HASH_SALT_SEPARATOR=
FIREBASE_HASH_ROUNDS=
FIREBASE_HASH_MEM_COST=
